#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
SOURCE_CONFIG="$REPO_DIR/dotfiles/alacritty/alacritty.toml"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty"
TARGET_CONFIG="$CONFIG_DIR/alacritty.toml"

mkdir -p "$CONFIG_DIR"

if [[ -L "$TARGET_CONFIG" ]] &&
  [[ "$(readlink -f "$TARGET_CONFIG")" == "$(readlink -f "$SOURCE_CONFIG")" ]]; then
  echo "Alacritty config already linked to $SOURCE_CONFIG"
  exit 0
fi

if [[ -e "$TARGET_CONFIG" || -L "$TARGET_CONFIG" ]]; then
  backup_config="$TARGET_CONFIG.backup.$(date +%Y%m%d%H%M%S)"
  mv "$TARGET_CONFIG" "$backup_config"
  echo "Backed up existing Alacritty config to $backup_config"
fi

ln -sf "$SOURCE_CONFIG" "$TARGET_CONFIG"
echo "Linked $TARGET_CONFIG -> $SOURCE_CONFIG"

[Unit]
Description=Telegram exercise reminder
ConditionPathExists=%h/repo/environments/envs/telegram/telegram.env

[Service]
Type=oneshot
EnvironmentFile=%h/repo/environments/envs/telegram/telegram.env
ExecStart=%h/repo/environments/scripts/telegram/send_telegram_message.sh --message "Exercise check: stand up and move for 5 minutes. Walk, stretch, push-ups, sit-ups, or anything else counts."

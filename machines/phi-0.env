# Machine-specific environment: phi-0 (homelab server)
SECOND_BRAIN_VAULT="$HOME/Obsidian/valhalla"
PATH="$HOME/.nvm/versions/node/v22.22.1/bin:$PATH"

# OpenClaw completion
[[ -f "$HOME/.openclaw/completions/openclaw.zsh" ]] && source "$HOME/.openclaw/completions/openclaw.zsh"

# Shared automation path overrides for scripts in environments/scripts/automation
AIRTRAIL_ENV_FILE="$HOME/.openclaw/workspace/.secrets/airtrail.env"
AIRTRAIL_QUEUE_FILE="$HOME/.openclaw/workspace/automation/airtrail/queue.jsonl"
TRANSMISSION_ENV_FILE="/home/phitrine/docker/transmission/.env"
TELEGRAM_ENV_FILE="/home/phitrine/repo/environments/envs/telegram/telegram.env"
DAILY_JOURNAL_ROOT="$HOME/Obsidian/valhalla/Areas/Personal/Dailies"
JAPANESE_WORD_ARCHIVE="$HOME/Obsidian/valhalla/Resources/Japanese Word Lookup Archive.md"
JAPANESE_STUDY_ARCHIVE="$HOME/Obsidian/valhalla/Resources/Japanese Study Lookup Archive.md"
PORTS_REGISTRY_PATH="$HOME/Obsidian/valhalla/Resources/Infrastructure/PORTS.md"

# OpenAI API key from systemd environment.d
[[ -f "$HOME/.config/environment.d/openai.conf" ]] && OPENAI_API_KEY="$(grep "^OPENAI_API_KEY=" "$HOME/.config/environment.d/openai.conf" | cut -d= -f2-)"
